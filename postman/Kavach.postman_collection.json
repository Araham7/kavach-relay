          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function(){ pm.response.to.have.status(200); });",
                  "pm.test('Is HTML', function(){ pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'); pm.expect(pm.response.text()).to.include('<title>Kavach</title>'); });",
                  "pm.test('Fast (<1s)', function(){ pm.expect(pm.response.responseTime).to.be.below(1000); });",
                  "pm.test('Security headers present', function(){",
                  "  pm.response.to.have.header('Content-Security-Policy');",
                  "  pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "  pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY');",
                  "  pm.expect(pm.response.headers.get('Referrer-Policy')).to.eql('no-referrer');",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store');",
                  "});",
                  "pm.test('CSP blocks inline scripts and other sites', function(){",
                  "  var c=pm.response.headers.get('Content-Security-Policy');",
                  "  pm.expect(c).to.include(\"default-src 'none'\"); pm.expect(c).to.include(\"script-src 'self'\"); pm.expect(c).to.include(\"frame-ancestors 'none'\");",
                  "});",
                  "pm.test('HSTS when using https', function(){",
                  "  if (String(pm.variables.get('baseUrl')).indexOf('https')===0) pm.response.to.have.header('Strict-Transport-Security');",
                  "});",
                  "pm.test('Server does not reveal its software', function(){ pm.expect(pm.response.headers.has('X-Powered-By')).to.be.false; });"
                ]
              }
            }
          ]
