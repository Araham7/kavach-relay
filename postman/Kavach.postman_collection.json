  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Make two random mailbox IDs (rid = secret, sid = public address) like the app does.",
          "function b64url(wa){return CryptoJS.enc.Base64.stringify(wa).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');}",
          "function sidOf(rid){return b64url(CryptoJS.SHA256('kavach-sid|'+rid));}",
          "function fresh(){var r=b64url(CryptoJS.lib.WordArray.random(32));return r;}",
          "var force = pm.info.requestName.indexOf('Generate')===0;",
          "['A','B'].forEach(function(x){",
          "  if(force || !pm.collectionVariables.get('rid'+x)){",
          "    var r=fresh(); pm.collectionVariables.set('rid'+x,r); pm.collectionVariables.set('sid'+x,sidOf(r));",
          "  }",
          "});"
        ]
      }
    }
  ],
