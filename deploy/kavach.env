PORT=8443
HOST=0.0.0.0
TLS_CERT=/etc/kavach/cert.pem
TLS_KEY=/etc/kavach/key.pem
# Comma-separated; must exactly match the URL you open in the browser
ALLOWED_ORIGINS=https://192.168.1.50:8443
STUN_URLS=stun:192.168.1.50:3478
TURN_URLS=turns:192.168.1.50:5349?transport=tcp,turn:192.168.1.50:3478?transport=udp
TURN_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
# Private server mode: only devices that enter this key (Settings -> Security -> Private server) can connect.
# Generate with: openssl rand -base64 24     (leave empty to allow anyone with an invite)
ACCESS_KEY=
